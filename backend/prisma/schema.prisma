generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "autoridad"]
}

// ==========================================
// MÓDULO USUARIOS Y CLIENTES
// ==========================================

model Usuario {
  idusuario   Int      @id @default(autoincrement())
  nombre      String
  apellido    String
  email       String   @unique
  contrasenia String
  rol         String // Ej: 'ADMIN', 'GUIA', 'CLIENTE'
  estado      String   @default("ACTIVO")
  creadoEn    DateTime @default(now())

  // Relaciones 1 a 1
  cliente    Cliente?
  guia       Guia?
  reembolsos Reembolso[] // Nueva relación para los reembolsos gestionados por el usuario

  @@schema("public")
}

model Cliente {
  idcliente  Int    @id @default(autoincrement())
  idusuario  Int    @unique // Clave foránea única para relación 1:1
  nroCliente String @unique
  estado     String

  usuario  Usuario   @relation(fields: [idusuario], references: [idusuario])
  reservas Reserva[]
  resenias Resenia[]

  @@schema("public")
}

// ==========================================
// MÓDULO RESERVAS Y SOLICITUDES
// ==========================================

model Reserva {
  idreserva              Int      @id @default(autoincrement())
  idcliente              Int
  idsalida               Int
  nroReserva             String   @unique
  fechaRealizacion       DateTime @default(now())
  cantidadPasajeros      Int
  precioCongelado        Float
  condicionesComerciales String?
  estado                 String
  estadoAlojamiento      String?

  cliente     Cliente             @relation(fields: [idcliente], references: [idcliente])
  salida      Salida              @relation(fields: [idsalida], references: [idsalida])
  pasajeros   ReservaPasajero[]
  pagos       Pago[]
  reembolsos  Reembolso[] // Relación con el nuevo modelo Reembolso
  solicitudes Solicitud[]
  permisos    PermisoPasajero[] // Relación con los permisos de pasajero tramitados

  @@schema("public")
}

model Reembolso {
  idreembolso      Int      @id @default(autoincrement())
  idreserva        Int
  idusuario        Int
  montoReembolsado Float
  motivo           String
  fechaReembolso   DateTime @default(now())

  reserva Reserva @relation(fields: [idreserva], references: [idreserva])
  usuario Usuario @relation(fields: [idusuario], references: [idusuario])

  @@schema("public")
}

model Pago {
  nrotransaccion    Int      @id @default(autoincrement())
  idreserva         Int
  monto             Float
  medioPago         String
  estadoTransaccion String
  fechahora         DateTime @default(now())
  reserva           Reserva  @relation(fields: [idreserva], references: [idreserva])

  @@schema("public")
}

model Solicitud {
  idsolicitud    Int     @id @default(autoincrement())
  idreserva      Int
  nroSolicitud   String  @unique
  estado         String
  cantidadPlazas Int
  criterios      String?

  reserva   Reserva            @relation(fields: [idreserva], references: [idreserva])
  gestiones GestionSolicitud[]

  @@schema("public")
}

model GestionSolicitud {
  idsolicitud    Int
  idservicio     Int
  resultado      String
  motivoRechazo  String?
  fechaRespuesta DateTime @default(now())

  solicitud Solicitud    @relation(fields: [idsolicitud], references: [idsolicitud])
  servicio  ServicioBase @relation(fields: [idservicio], references: [idservicio])

  @@id([idsolicitud, idservicio])
  @@schema("public")
}

model Resenia {
  idcliente  Int
  idsalida   Int
  valoracion Int
  comentario String?
  fechaEnvio DateTime @default(now())

  cliente Cliente @relation(fields: [idcliente], references: [idcliente])
  salida  Salida  @relation(fields: [idsalida], references: [idsalida])

  @@id([idcliente, idsalida])
  @@schema("public")
}

// ==========================================
// MÓDULO PERSONAL Y PASAJEROS
// ==========================================

model Personal {
  idpersonal                Int      @id @default(autoincrement())
  nombreCompleto            String
  nroPasaporte              String   @unique
  nacionalidad              String
  fechaVencimientoPasaporte DateTime
  estado                    String
  rol                       String // Ej: 'Guía', 'Porteador'

  guia         Guia?
  idiomas      Idioma[]
  asignaciones AsignacionPersonal[]
  permisos     PermisoPersonal[] // Relación con el permiso específico
  evaluaciones EvaluacionPersonal[]

  @@schema("public")
}

model Guia {
  idpersonal        Int       @id
  idusuario         Int?      @unique
  nroHabilitacion   String?
  fechaHabilitacion DateTime?

  personal Personal @relation(fields: [idpersonal], references: [idpersonal])
  usuario  Usuario? @relation(fields: [idusuario], references: [idusuario])

  @@schema("public")
}

model Pasajero {
  idpasajero                Int                 @id @default(autoincrement())
  nombreCompleto            String
  nroPasaporte              String              @unique
  nacionalidad              String
  fechaVencimientoPasaporte DateTime
  reservas                  ReservaPasajero[]
  incidentes                IncidentePasajero[]
  permisos                  PermisoPasajero[] // Relación con el permiso específico

  @@schema("public")
}

model ReservaPasajero {
  idreserva  Int
  idpasajero Int
  reserva    Reserva  @relation(fields: [idreserva], references: [idreserva])
  pasajero   Pasajero @relation(fields: [idpasajero], references: [idpasajero])

  @@id([idreserva, idpasajero])
  @@schema("public")
}

// ==========================================
// NUEVO ESQUEMA DE PERMISOS SEPARADOS
// ==========================================

model PermisoPasajero {
  idpermisopasajero Int      @id @default(autoincrement())
  idreserva         Int
  idpasajero        Int
  nroPermiso        String   @unique
  fechaEmision      DateTime
  estadoTramite     String

  reserva  Reserva  @relation(fields: [idreserva], references: [idreserva])
  pasajero Pasajero @relation(fields: [idpasajero], references: [idpasajero])

  @@schema("public")
}

model PermisoPersonal {
  idpermisopersonal Int      @id @default(autoincrement())
  idsalida          Int
  idpersonal        Int
  nroPermiso        String   @unique
  fechaEmision      DateTime
  estadoTramite     String

  salida   Salida   @relation(fields: [idsalida], references: [idsalida])
  personal Personal @relation(fields: [idpersonal], references: [idpersonal])

  @@schema("public")
}

// ==========================================
// MÓDULO PAQUETES Y CIRCUITOS
// ==========================================

model Paquete {
  idpaquete                 Int     @id @default(autoincrement())
  idcircuito                Int
  nroPaquete                String  @unique
  nombrePaquete             String
  condiciones               String?
  estado                    String
  tipoGarantia              String
  localidadGarantizada      String?
  categoriaGarantizada      String?
  tipoHabitacionGarantizada String?
  nochesPrevias             Int     @default(0)
  nochesPosteriores         Int     @default(0)
  diasDisponibles           String? // Formato JSON o CSV de días habilitados

  circuito                 Circuito                  @relation(fields: [idcircuito], references: [idcircuito])
  garantiasEstablecimiento GarantiaEstablecimiento[]
  tarifas                  TarifaPaquete[]
  servicios                PaqueteServicio[]
  salidas                  Salida[]

  @@schema("public")
}

model GarantiaEstablecimiento {
  idpaquete  Int          @id
  idservicio Int
  paquete    Paquete      @relation(fields: [idpaquete], references: [idpaquete])
  servicio   ServicioBase @relation(fields: [idservicio], references: [idservicio])

  @@schema("public")
}

model Circuito {
  idcircuito            Int         @id @default(autoincrement())
  nombreCircuito        String
  duracionDias          Int
  dificultad            String
  minimoGuias           Int
  parametrosPorteadores String?
  estado                String      @default("ACTIVO")
  etapas                EtapaRuta[]
  paquetes              Paquete[]
  avances               Avance[]

  @@schema("public")
}

model EtapaRuta {
  idcircuito         Int
  numeroOrden        Int
  puntoInicio        String
  puntoFin           String
  campamentoPrevisto String?
  circuito           Circuito @relation(fields: [idcircuito], references: [idcircuito])
  avances            Avance[]

  @@id([idcircuito, numeroOrden])
  @@schema("public")
}

model Temporada {
  idtemporada Int             @id @default(autoincrement())
  nombre      String
  fechaInicio DateTime
  fechaFin    DateTime
  estado      String          @default("ACTIVO")
  tarifas     TarifaPaquete[]

  @@schema("public")
}

model TarifaPaquete {
  idpaquete   Int
  idtemporada Int
  monto       Float
  moneda      String
  paquete     Paquete   @relation(fields: [idpaquete], references: [idpaquete])
  temporada   Temporada @relation(fields: [idtemporada], references: [idtemporada])

  @@id([idpaquete, idtemporada])
  @@schema("public")
}

// ==========================================
// MÓDULO OPERACIONES Y SALIDAS
// ==========================================

model Salida {
  idsalida              Int      @id @default(autoincrement())
  idpaquete             Int
  nroSalida             String   @unique
  idbloqueo             String?
  stockLocal            Int // Restricción CHECK pendiente en BD
  stockLocalAlojamiento Int?
  tamanoMaximo          Int
  fechaInicio           DateTime
  fechaFin              DateTime
  estado                String
  ultimaEtapaAlcanzada  Int?

  paquete   Paquete          @relation(fields: [idpaquete], references: [idpaquete])
  servicios SalidaServicio[]

  reservas                Reserva[]
  resenias                Resenia[]
  equipamientos           SalidaEquipamiento[]
  personalAsignado        AsignacionPersonal[]
  permisos                PermisoPersonal[] // Relacionado con los permisos específicos
  avances                 Avance[]
  incidentes              Incidente[]
  auditorias              RegistroAuditoria[]
  evaluacionesPersonal    EvaluacionPersonal[]
  evaluacionesProveedores EvaluacionProveedor[]

  @@schema("public")
}

model SalidaServicio {
  idsalida   Int
  idservicio         Int
  tipo               String
  comprobanteReserva String? // Solo TRANSPORTE: comprobante de la reserva externa (CU-39)

  salida   Salida       @relation(fields: [idsalida], references: [idsalida])
  servicio ServicioBase @relation(fields: [idservicio], references: [idservicio])

  @@unique([idsalida, tipo])
  @@schema("public")
}

model Avance {
  idavance         Int       @id @default(autoincrement())
  idsalida         Int
  idcircuito       Int
  numeroOrden      Int
  estadoTramo      String
  fechaHoraLlegada DateTime?
  fechaHoraReporte DateTime  @default(now())

  salida   Salida    @relation(fields: [idsalida], references: [idsalida])
  circuito Circuito  @relation(fields: [idcircuito], references: [idcircuito])
  etapa    EtapaRuta @relation(fields: [idcircuito, numeroOrden], references: [idcircuito, numeroOrden])

  @@schema("public")
}

model Incidente {
  idincidente         Int                 @id @default(autoincrement())
  idsalida            Int
  tipoIncidente       String
  descripcion         String
  nivelGravedad       String
  fechaHoraOcurrencia DateTime
  fechaHoraReporte    DateTime            @default(now())
  salida              Salida              @relation(fields: [idsalida], references: [idsalida])
  pasajeros           IncidentePasajero[]

  @@schema("public")
}

model IncidentePasajero {
  idincidente Int
  idpasajero  Int
  incidente   Incidente @relation(fields: [idincidente], references: [idincidente])
  pasajero    Pasajero  @relation(fields: [idpasajero], references: [idpasajero])

  @@id([idincidente, idpasajero])
  @@schema("public")
}

model RegistroAuditoria {
  idcambio    Int      @id @default(autoincrement())
  idsalida    Int
  fechaActual DateTime @default(now())
  usuario     String
  motivo      String?
  cambios     Json // Almacena el snapshot de antes y después

  salida Salida @relation(fields: [idsalida], references: [idsalida])

  @@schema("public")
}

// ==========================================
// MÓDULO ASIGNACIÓN DE PERSONAL
// ==========================================

model Idioma {
  idpersonal   Int
  nombre       String
  nivelDominio String
  esNativo     Boolean
  estado       String

  personal Personal @relation(fields: [idpersonal], references: [idpersonal])

  @@id([idpersonal, nombre])
  @@schema("public")
}

model AsignacionPersonal {
  idsalida   Int
  idpersonal Int
  salida     Salida   @relation(fields: [idsalida], references: [idsalida])
  personal   Personal @relation(fields: [idpersonal], references: [idpersonal])

  @@id([idsalida, idpersonal])
  @@schema("public")
}

// ==========================================
// MÓDULO PROVEEDORES Y SERVICIOS (Herencia CTI)
// ==========================================

model Proveedor {
  idproveedor       Int                   @id @default(autoincrement())
  tipoProveedor     String
  razonSocial       String
  localidad         String
  datosContacto     String
  canalComunicacion String?
  estado            String
  servicios         ServicioBase[]
  evaluaciones      EvaluacionProveedor[]

  @@schema("public")
}

model ServicioBase {
  idservicio     Int     @id @default(autoincrement())
  idproveedor    Int
  nombreServicio String
  descripcion    String?
  costoBase      Float
  estado         String
  localidad      String

  proveedor Proveedor @relation(fields: [idproveedor], references: [idproveedor])

  // Relaciones hacia los subtipos (Patrón CTI)
  alojamiento  ServicioAlojamiento?
  transporte   ServicioTransporte?
  tren         ServicioTren?
  equipamiento ServicioEquipamiento?

  // Relaciones inversas
  paquetes                 PaqueteServicio[]
  garantiasEstablecimiento GarantiaEstablecimiento[]
  gestiones                GestionSolicitud[]

  salidas      SalidaServicio[]
  salidasEquip SalidaEquipamiento[]

  @@schema("public")
}

model ServicioAlojamiento {
  idservicio            Int          @id
  categoria             String
  tipoHabitacion        String
  capacidadDisponible   Int
  modalidadConfirmacion String
  servicio              ServicioBase @relation(fields: [idservicio], references: [idservicio])

  @@schema("public")
}

model ServicioTransporte {
  idservicio           Int          @id
  capacidadVehiculo    Int
  pesoEquipajeIncluido Float
  costoPorKgExcedente  Float
  servicio             ServicioBase @relation(fields: [idservicio], references: [idservicio])

  @@schema("public")
}

model ServicioTren {
  idservicio     Int          @id
  horarioSalida  String
  horarioLlegada String
  diasOperacion  String // Ej: L-M-X-J-V-S-D
  servicio       ServicioBase @relation(fields: [idservicio], references: [idservicio])

  @@schema("public")
}

model ServicioEquipamiento {
  idservicio         Int          @id
  tipoEquipamiento   String
  cantidadDisponible Int
  servicio           ServicioBase @relation(fields: [idservicio], references: [idservicio])

  @@schema("public")
}

model PaqueteServicio {
  idpaquete  Int
  idservicio Int
  paquete    Paquete      @relation(fields: [idpaquete], references: [idpaquete])
  servicio   ServicioBase @relation(fields: [idservicio], references: [idservicio])

  @@id([idpaquete, idservicio])
  @@schema("public")
}

model SalidaEquipamiento {
  idsalida   Int
  idservicio Int
  cantidad   Int
  salida     Salida       @relation(fields: [idsalida], references: [idsalida])
  servicio   ServicioBase @relation(fields: [idservicio], references: [idservicio])

  @@id([idsalida, idservicio])
  @@schema("public")
}

// CU-42: el administrador evalúa al personal y a los proveedores por su desempeño en una salida.
// Clave compuesta: una sola evaluación por salida y por evaluado (como RESENIA).
model EvaluacionPersonal {
  idsalida        Int
  idpersonal      Int
  puntaje         Int // 1 a 5 (CHECK en la migración)
  comentario      String?
  fechaEvaluacion DateTime @default(now())

  salida   Salida   @relation(fields: [idsalida], references: [idsalida])
  personal Personal @relation(fields: [idpersonal], references: [idpersonal])

  @@id([idsalida, idpersonal])
  @@schema("public")
}

model EvaluacionProveedor {
  idsalida        Int
  idproveedor     Int
  puntaje         Int // 1 a 5 (CHECK en la migración)
  comentario      String?
  fechaEvaluacion DateTime @default(now())

  salida    Salida    @relation(fields: [idsalida], references: [idsalida])
  proveedor Proveedor @relation(fields: [idproveedor], references: [idproveedor])

  @@id([idsalida, idproveedor])
  @@schema("public")
}

// ── Autoridad simulada (ApiDDCGobierno) ────────────────────────────────────────
// Simula el sistema EXTERNO de la autoridad del Camino Inca: tiene su propio almacenamiento y
// ninguna FK hacia las tablas del sistema. Solo la usa integraciones/autoridad/autoridad.simulada.ts.
model AutoridadCupoDiario {
  fecha    String @id // "2026-11-15"
  ocupados Int    @default(0) // lugares bloqueados ese día (tope: 500)

  @@map("cupo_diario")
  @@schema("autoridad")
}

model AutoridadBloqueo {
  idBloqueo String             @id
  fecha     String
  lugares   Int
  permisos  AutoridadPermiso[]

  @@map("bloqueo")
  @@schema("autoridad")
}

model AutoridadPermiso {
  nroPermiso String           @id
  idBloqueo  String
  vigente    Boolean          @default(true)
  bloqueo    AutoridadBloqueo @relation(fields: [idBloqueo], references: [idBloqueo], onDelete: Cascade)

  @@map("permiso")
  @@schema("autoridad")
}
